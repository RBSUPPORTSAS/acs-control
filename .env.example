# ==========================================================
# ACS Control - Example configuration
# Copy this file to your private .env and adjust the values.
# NEVER commit the real .env file.
# ==========================================================

# Application
APP_NAME="ACS Control"
APP_ENV="production"
APP_HOST="127.0.0.1"
APP_PORT=8000

# Timezone
TIMEZONE="America/Bogota"

# Generate a strong random value for production.
# Example:
# openssl rand -hex 32
APP_SECRET_KEY="CHANGE_ME_WITH_A_RANDOM_SECRET"

# GenieACS NBI
# Example:
# http://192.0.2.10:7557
GENIEACS_NBI_URL="http://GENIEACS_HOST:7557"
GENIEACS_TIMEOUT=15

# PostgreSQL
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql+asyncpg://acs_control_app:CHANGE_ME@127.0.0.1:5432/acs_control"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL="INFO"
